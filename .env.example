# ── Database ────────────────────────────────────────────────────────────────
# Dev default: SQLite file. For production use:
#   postgresql://user:password@host:5432/pulsewatch?schema=public
DATABASE_URL="file:./dev.db"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# ── Redis (optional — falls back to in-memory store) ────────────────────────
# docker run -p 6379:6379 redis:7-alpine
REDIS_URL="redis://localhost:6379"

# ── Public app URL (used for links & status pages) ──────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Background scheduler ────────────────────────────────────────────────────
# Random secret so only the scheduler/system can hit /api/v1/cron/check
CRON_SECRET="change-me-too"
